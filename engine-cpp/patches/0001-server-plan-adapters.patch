+// The score alone, the first stage of a generate: one plan drawn with
+// lm_seed under the planner half of the request's adapters, nothing
+// rendered. The score can be edited and sent back as the abc of a request.
+static bool pipeline_plan(Yue2Pipeline *      p,
+                          const Yue2Request & r,
+                          std::string *       score,
+                          bool *              truncated,
+                          bool (*cancelled)(void *) = nullptr,
+                          void * cancel_data        = nullptr) {
+    Yue2Cot cot;
+    if (!yue2_cot_parse(r.cot, &cot) || cot == YUE2_COT_OFF) {
+        fprintf(stderr, "[Plan] FATAL: cot must be full or melody to write a score\n");
+        return false;
+    }
+    if (!yue2_sampling_valid(r.abc_sampling, "abc")) {
+        return false;
+    }
+    std::vector<AdapterUse> ar_adapters, nar_adapters;
+    if (!pipeline_adapters(p, r, &ar_adapters, &nar_adapters)) {
+        return false;
+    }
+
+    KvScope        kv_scope = { p };
+    BPETokenizer * tok      = store_bpe(p->store, p->model_path.c_str());
+    auto           encode   = [tok](const std::string & text) {
+        return bpe_encode(tok, text);
+    };
+    Qwen3LM * lm = require_lm(p, ar_adapters);
+    if (!lm) {
+        return false;
+    }
+    ModelHandle                 hold(p->store, lm);
+    std::vector<int>            open = yue2_build_prompt_ids(encode, cot, r.style, r.lyrics, nullptr);
+    std::vector<Yue2Generation> plans;
+    if (!yue2_generate(lm, &p->kv, std::vector<std::vector<int>>(1, open), {}, 1.0f, r.abc_sampling, r.lm_seed,
+                       YUE2_PHASE_ABC, &plans, cancelled, cancel_data)) {
+        return false;
+    }
+    *score     = bpe_decode(tok, plans[0].tokens);
+    *truncated = plans[0].truncated;
+    fprintf(stderr, "[Plan] Score %zu tokens%s, seed %lld\n", plans[0].tokens.size(),
+            plans[0].truncated ? " (truncated)" : "", (long long) r.lm_seed);
+    return true;
+}
+
+// The adapter directory read again, so a file put there since the start can
+// be named by the next request. Called from the thread that runs the jobs.
+static void pipeline_rescan_adapters(Yue2Pipeline * p) {
+    if (p->params.adapters_dir) {
+        p->adapters = adapter_scan(p->params.adapters_dir);
+    }
+}
