+    // POST /plan, the body of /synth: the score alone, returned as
+    // {"abc", "truncated", "lm_seed"}
+    svr.Post("/plan", [](const httplib::Request & req, httplib::Response & res) {
+        Yue2Request request;
+        if (!validate(req.body, res, &request)) {
+            return;
+        }
+        auto job = job_create();
+        work_push([job, request] { run_plan(job, request); });
+        res.set_content(json_string("id", job->id), "application/json");
+    });
+
+    // POST /adapters/rescan: the adapter directory is read again once the
+    // jobs ahead have run, for a file put there since the start
+    svr.Post("/adapters/rescan", [](const httplib::Request &, httplib::Response & res) {
+        work_push([] {
+            std::lock_guard<std::mutex> lock(mtx_adapters);
+            pipeline_rescan_adapters(&g_pipeline);
+            fprintf(stderr, "[Server] Adapters rescanned: %zu\n", g_pipeline.adapters.size());
+        });
+        res.set_content(json_string("status", "queued"), "application/json");
+    });
