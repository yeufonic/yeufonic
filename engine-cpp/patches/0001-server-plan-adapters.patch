+// Plan worker: the score alone, with the seed it was drawn with, nothing
+// rendered
+static void run_plan(std::shared_ptr<Job> job, Yue2Request request) {
+    active_job_set(job);
+    fprintf(stderr, "[Server] Plan job %s: %s\n", job->id.c_str(), request_to_json(&request).c_str());
+    std::string score;
+    bool        truncated = false;
+    bool ok = pipeline_plan(&g_pipeline, request, &score, &truncated, server_cancel_job, (void *) &job->cancel);
+    active_job_set(nullptr);
+    if (!ok) {
+        job->status.store(job->cancel.load() ? JobStatus::CANCELLED : JobStatus::FAILED);
+        return;
+    }
+    yyjson_mut_doc * doc  = yyjson_mut_doc_new(NULL);
+    yyjson_mut_val * root = yyjson_mut_obj(doc);
+    yyjson_mut_doc_set_root(doc, root);
+    yyjson_mut_obj_add_strncpy(doc, root, "abc", score.c_str(), score.size());
+    yyjson_mut_obj_add_bool(doc, root, "truncated", truncated);
+    yyjson_mut_obj_add_int(doc, root, "lm_seed", request.lm_seed);
+    char * json = yyjson_mut_write(doc, 0, NULL);
+    job->result_body = json ? json : "{}";
+    if (json) {
+        free(json);
+    }
+    yyjson_mut_doc_free(doc);
+    job->result_mime = "application/json";
+    job->status.store(JobStatus::DONE);
+}
