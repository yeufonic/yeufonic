--- /dev/null
+++ b/src/harmony.h
@@ -0,0 +1,690 @@
+#pragma once
+// harmony.h: steering the score plan's chords and structure
+//
+// YuE2's planner tends to write one four-chord loop and use it for every
+// section. The stock repetition penalty cannot fix that: it pushes against
+// every recent token, bar lines and section names included, and breaks the
+// score long before the chords change. This pushes against recently used
+// chords only, while the planner writes a chord symbol ("Cmaj7"): a candidate
+// token that would spell a recently used chord loses logits in proportion to
+// that chord's share of recent chord changes. Holding the current chord is
+// free up to a limit; past it, staying on the same root costs more with every
+// bar. Two ways to name "the same chord": by exact spelling (Cmaj7 and C
+// differ), or by root (C, Cmaj7 and C/E are one).
+//
+// A section penalty keeps a section from opening the way the one before it
+// did. An outside bonus favours roots outside the key of the K: line while
+// few recent chords are outside it. A structure can be followed exactly: the
+// name written after a "%" must be the next of the given sections, no other
+// section may start once they are used, and the plan may not end before the
+// last has some chords. A hook (a tune's header and bars) can be held: the
+// plan opens with its header, and every section of its name holds its bars.
+//
+// Nothing is forbidden outright and no chord is chosen: the tracker only adds
+// to or takes from logits before the distribution. With nothing asked for it
+// is inactive and the plan is the stock planner's. A port of the Yeufonic
+// app's ComfyUI node (yue2_harmony), kept to its behaviour.
+
+#include "bpe.h"
+#include "prompt.h"
+
+#include <algorithm>
+#include <cctype>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+struct Yue2Harmony {
+    std::string              chord_identity   = "root";  // "root" or "spelling"
+    float                    chord_strength   = 0.0f;    // logits taken for a chord's share of recent changes
+    int                      chord_window     = 16;      // recent chord changes remembered
+    int                      hold_limit       = 8;       // chords one root may hold before it costs, 0 no limit
+    float                    outside_bonus    = 0.0f;    // root mode: logits added to a root outside the key
+    float                    outside_limit    = 0.25f;   // the bonus stops at this share of recent chords outside
+    float                    section_strength = 0.0f;    // logits taken from copying the last section's opening
+    int                      section_open     = 4;       // opening chords compared between sections
+    std::vector<std::string> follow_sections;            // section names in order, empty is off
+    std::string              hook_head;                  // the header the plan opens with, through K:
+    std::string              hook_body;                  // the bars every hook section holds
+    std::string              hook_section;               // the section the hook fills
+
+    bool any() const {
+        return chord_strength > 0.0f || outside_bonus > 0.0f || section_strength > 0.0f ||
+               !follow_sections.empty() || !hook_head.empty() || (!hook_body.empty() && !hook_section.empty());
+    }
+};
+
+static const float HARMONY_FOLLOW_BOOST       = 50.0f;
+static const float HARMONY_HOOK_BOOST         = 100.0f;
+static const float HARMONY_HOOK_LONGEST       = 20.0f;
+static const int   HARMONY_FOLLOW_LAST_CHORDS = 4;
+
+// Decoded text of every planner token, built once per tokenizer
+static const std::vector<std::string> & harmony_vocab(const BPETokenizer * tok) {
+    static const BPETokenizer *     built_for = nullptr;
+    static std::vector<std::string> vocab;
+    if (built_for == tok) {
+        return vocab;
+    }
+    std::unordered_map<std::string, char> str2byte;
+    for (int b = 0; b < 256; b++) {
+        str2byte[tok->byte2str[b]] = (char) b;
+    }
+    vocab.assign((size_t) YUE2_EOD, std::string());
+    for (int id = 0; id < YUE2_EOD && id < (int) tok->id_to_str.size(); id++) {
+        const std::string & enc = tok->id_to_str[(size_t) id];
+        std::string         out;
+        size_t              pos = 0;
+        while (pos < enc.size()) {
+            unsigned char lead = (unsigned char) enc[pos];
+            size_t        len  = lead < 0x80 ? 1 : (lead < 0xE0 ? 2 : 3);
+            auto          it   = str2byte.find(enc.substr(pos, len));
+            if (it != str2byte.end()) {
+                out += it->second;
+            }
+            pos += len;
+        }
+        vocab[(size_t) id] = out;
+    }
+    built_for = tok;
+    return vocab;
+}
+
+static int harmony_note(char c) {
+    switch (c) {
+        case 'C': return 0;
+        case 'D': return 2;
+        case 'E': return 4;
+        case 'F': return 5;
+        case 'G': return 7;
+        case 'A': return 9;
+        case 'B': return 11;
+        default: return -1;
+    }
+}
+
+// Pitch class of a chord's root, or -1. A lone letter counts as the natural.
+static int harmony_root(const std::string & text) {
+    if (text.empty() || harmony_note(text[0]) < 0) {
+        return -1;
+    }
+    int pc = harmony_note(text[0]);
+    if (text.size() > 1 && text[1] == '#') {
+        pc += 1;
+    } else if (text.size() > 1 && text[1] == 'b') {
+        pc -= 1;
+    }
+    return ((pc % 12) + 12) % 12;
+}
+
+static bool harmony_is_header(const std::string & line) {
+    return line.size() >= 2 && std::isalpha((unsigned char) line[0]) && line[1] == ':';
+}
+
+// "% name" as a whole line: the name, lower case and trimmed, or empty
+static std::string harmony_section_name(const std::string & line) {
+    if (line.empty() || line[0] != '%') {
+        return "";
+    }
+    size_t i = 1;
+    while (i < line.size() && std::isspace((unsigned char) line[i])) {
+        i++;
+    }
+    if (i >= line.size() || !std::isalpha((unsigned char) line[i])) {
+        return "";
+    }
+    std::string name;
+    for (size_t j = i; j < line.size(); j++) {
+        unsigned char c = (unsigned char) line[j];
+        if (!(std::isalnum(c) || c == '_' || c == ' ' || c == '-')) {
+            return "";
+        }
+        name += (char) std::tolower(c);
+    }
+    while (!name.empty() && name.back() == ' ') {
+        name.pop_back();
+    }
+    return name;
+}
+
+static std::string harmony_lower_trim(const std::string & s) {
+    size_t a = 0, b = s.size();
+    while (a < b && std::isspace((unsigned char) s[a])) {
+        a++;
+    }
+    while (b > a && std::isspace((unsigned char) s[b - 1])) {
+        b--;
+    }
+    std::string out;
+    for (size_t i = a; i < b; i++) {
+        out += (char) std::tolower((unsigned char) s[i]);
+    }
+    return out;
+}
+
+static bool harmony_starts_with(const std::string & s, const std::string & prefix) {
+    return s.size() >= prefix.size() && s.compare(0, prefix.size(), prefix) == 0;
+}
+
+// The chord-symbol state over text. Quotes on header lines (V: name="...")
+// are not chords. partial_open says a symbol is being written.
+struct HarmonyWalk {
+    std::string              line;
+    bool                     open = false;
+    std::string              partial;
+    std::vector<std::string> done;
+};
+
+static void harmony_walk(const std::string & text, HarmonyWalk * w) {
+    w->done.clear();
+    for (char ch : text) {
+        if (ch == '\n') {
+            w->line.clear();
+            w->open = false;
+            w->partial.clear();
+            continue;
+        }
+        if (!w->open) {
+            if (ch == '"' && !harmony_is_header(w->line)) {
+                w->open = true;
+                w->partial.clear();
+            }
+        } else if (ch == '"') {
+            w->done.push_back(w->partial);
+            w->open = false;
+            w->partial.clear();
+        } else {
+            w->partial += ch;
+        }
+        w->line += ch;
+    }
+}
+
+class HarmonyTracker {
+  public:
+    HarmonyTracker(const std::vector<std::string> & vocab, const Yue2Harmony & h, int candidates) :
+        vocab_(vocab),
+        h_(h),
+        candidates_(std::max(64, candidates)) {
+        root_mode_     = h.chord_identity != "spelling";
+        outside_bonus_ = root_mode_ ? h.outside_bonus : 0.0f;
+        for (const std::string & name : h.follow_sections) {
+            std::string n = harmony_lower_trim(name);
+            if (!n.empty()) {
+                wanted_.push_back(n);
+            }
+        }
+        hook_body_    = h.hook_body;
+        hook_section_ = hook_body_.empty() ? "" : harmony_lower_trim(h.hook_section);
+        holding_      = h.hook_head;
+        for (int i = 0; i < (int) vocab_.size(); i++) {
+            const std::string & t = vocab_[(size_t) i];
+            if (t.size() >= 2 && t[0] == '"' && harmony_note(t[1]) >= 0) {
+                chord_starts_.push_back(i);
+            }
+        }
+    }
+
+    bool chord_active() const {
+        return h_.chord_strength > 0.0f || outside_bonus_ > 0.0f || h_.section_strength > 0.0f;
+    }
+
+    bool active() const { return chord_active() || !wanted_.empty() || !holding_.empty() || !hook_body_.empty(); }
+
+    int hooks() const { return hooks_; }
+
+    // Keep up with what the planner has written
+    void feed(const std::vector<int> & history) {
+        for (size_t k = (size_t) seen_; k < history.size(); k++) {
+            int                 token = history[k];
+            const std::string & text  = token >= 0 && token < (int) vocab_.size() ? vocab_[(size_t) token] : empty_;
+            if (!have_scale_ && root_mode_) {
+                head_ += text;
+                find_key();
+            }
+            follow_hook(text);
+            follow_sections(text);
+            harmony_walk(text, &walk_);
+            for (const std::string & symbol : walk_.done) {
+                int root = harmony_root(symbol);
+                if (root < 0) {
+                    continue;
+                }
+                section_chords_++;
+                if ((int) opening_.size() < h_.section_open && (opening_.empty() || opening_.back() != root)) {
+                    opening_.push_back(root);
+                }
+                if (root == last_root_) {
+                    held_++;
+                } else {
+                    last_root_ = root;
+                    held_      = 1;
+                }
+                std::string ident = identity(symbol);
+                if (changes_.empty() || changes_.back() != ident) {
+                    changes_.push_back(ident);
+                    if ((int) changes_.size() > h_.chord_window) {
+                        changes_.erase(changes_.begin());
+                    }
+                }
+            }
+        }
+        seen_ = (int) history.size();
+    }
+
+    // Logits for this step, as token -> value to subtract: the chords' and the
+    // structure's together, or the hook's alone while it holds the planner to
+    // its text. logits are the phase rows, indexed by token id.
+    void bias(const float * logits, std::vector<std::pair<int, float>> * out) {
+        out->clear();
+        if (hook_bias(out)) {
+            return;
+        }
+        std::map<int, float> merged;
+        if (chord_active()) {
+            chord_bias(logits, &merged);
+        }
+        if (!wanted_.empty()) {
+            follow_bias(logits, &merged);
+        }
+        out->assign(merged.begin(), merged.end());
+    }
+
+  private:
+    const std::vector<std::string> &  vocab_;
+    Yue2Harmony                       h_;
+    int                               candidates_;
+    bool                              root_mode_;
+    float                             outside_bonus_;
+    std::vector<std::string>          wanted_;
+    int                               section_count_  = 0;
+    int                               section_chords_ = 0;
+    std::vector<int>                  opening_, previous_;
+    int                               seen_ = 0;
+    HarmonyWalk                       walk_;
+    std::vector<std::string>          changes_;
+    int                               held_      = 0;
+    int                               last_root_ = -1;
+    std::string                       head_;
+    size_t                            key_scan_   = 0;  // where the next unread line of head_ starts
+    bool                              have_scale_ = false;
+    bool                              scale_[12]  = {};
+    std::vector<int>                  chord_starts_;
+    std::string                       hook_body_, hook_section_, holding_;
+    bool                              held_hook_  = false;
+    bool                              after_hook_ = false;
+    std::string                       hook_line_;
+    int                               hooks_ = 0;
+    std::map<char, std::vector<int>>  by_first_;
+    bool                              by_first_built_ = false;
+    std::vector<int>                  sections_start_;
+    bool                              sections_start_built_ = false;
+    std::map<std::string, std::vector<int>> spelling_;
+    std::string                       empty_;
+
+    std::string identity(const std::string & symbol) const {
+        return root_mode_ ? std::to_string(harmony_root(symbol)) : symbol;
+    }
+
+    // The key from the K: line, once the line is complete
+    void find_key() {
+        size_t & pos = key_scan_;
+        while (pos < head_.size()) {
+            size_t eol = head_.find('\n', pos);
+            if (eol == std::string::npos) {
+                return;
+            }
+            std::string line = head_.substr(pos, eol - pos);
+            if (line.size() >= 2 && line[0] == 'K' && line[1] == ':') {
+                size_t i = 2;
+                while (i < line.size() && std::isspace((unsigned char) line[i])) {
+                    i++;
+                }
+                if (i < line.size() && line[i] >= 'A' && line[i] <= 'G') {
+                    std::string note(1, line[i]);
+                    if (i + 1 < line.size() && (line[i + 1] == '#' || line[i + 1] == 'b')) {
+                        note += line[i + 1];
+                    }
+                    bool        minor = i + note.size() < line.size() && line[i + note.size()] == 'm';
+                    static const int major_steps[] = { 0, 2, 4, 5, 7, 9, 11 };
+                    static const int minor_steps[] = { 0, 2, 3, 5, 7, 8, 10 };
+                    int         tonic = harmony_root(note);
+                    for (int s : minor ? minor_steps : major_steps) {
+                        scale_[(tonic + s) % 12] = true;
+                    }
+                    have_scale_ = true;
+                    return;
+                }
+            }
+            pos = eol + 1;
+        }
+    }
+
+    void follow_hook(const std::string & text) {
+        for (char ch : text) {
+            if (!holding_.empty()) {
+                if (ch == holding_[0]) {
+                    holding_.erase(0, 1);
+                    if (holding_.empty()) {
+                        after_hook_ = held_hook_;
+                        held_hook_  = false;
+                        hook_line_.clear();
+                    }
+                    continue;
+                }
+                holding_.clear();
+                held_hook_ = false;
+            }
+            after_hook_ = false;
+            if (ch != '\n') {
+                hook_line_ += ch;
+                continue;
+            }
+            std::string found = harmony_section_name(hook_line_);
+            if (!hook_section_.empty() && !found.empty() && found == hook_section_) {
+                holding_   = hook_body_;
+                held_hook_ = true;
+                hooks_++;
+            }
+            hook_line_.clear();
+        }
+    }
+
+    void follow_sections(const std::string & text) {
+        std::string line = walk_.line;
+        for (char ch : text) {
+            if (ch != '\n') {
+                line += ch;
+                continue;
+            }
+            if (!harmony_section_name(line).empty()) {
+                previous_ = opening_;
+                opening_.clear();
+                section_count_++;
+                section_chords_ = 0;
+            }
+            line.clear();
+        }
+    }
+
+    // Every token that could be the next piece of text, by its first character
+    void tokens_starting(const std::string & text, std::vector<int> * out) {
+        if (!by_first_built_) {
+            for (int i = 0; i < (int) vocab_.size(); i++) {
+                if (!vocab_[(size_t) i].empty()) {
+                    by_first_[vocab_[(size_t) i][0]].push_back(i);
+                }
+            }
+            by_first_built_ = true;
+        }
+        out->clear();
+        if (text.empty()) {
+            return;
+        }
+        auto it = by_first_.find(text[0]);
+        if (it == by_first_.end()) {
+            return;
+        }
+        for (int i : it->second) {
+            if (harmony_starts_with(text, vocab_[(size_t) i])) {
+                out->push_back(i);
+            }
+        }
+    }
+
+    bool hook_bias(std::vector<std::pair<int, float>> * out) {
+        if (!holding_.empty()) {
+            std::vector<int> pieces;
+            tokens_starting(holding_, &pieces);
+            if (pieces.empty()) {
+                return false;
+            }
+            int longest = pieces[0];
+            for (int i : pieces) {
+                if (vocab_[(size_t) i].size() > vocab_[(size_t) longest].size()) {
+                    longest = i;
+                }
+            }
+            for (int i : pieces) {
+                out->push_back({ i, -(HARMONY_HOOK_BOOST + (i == longest ? HARMONY_HOOK_LONGEST : 0.0f)) });
+            }
+            return true;
+        }
+        if (!after_hook_) {
+            return false;
+        }
+        if (!sections_start_built_) {
+            for (int i = 0; i < (int) vocab_.size(); i++) {
+                const std::string & p = vocab_[(size_t) i];
+                if (!p.empty() && p[0] == '%' && !harmony_starts_with(p, "%%")) {
+                    sections_start_.push_back(i);
+                }
+            }
+            sections_start_built_ = true;
+        }
+        bool more = wanted_.empty() || section_count_ < (int) wanted_.size();
+        if (more) {
+            for (int i : sections_start_) {
+                out->push_back({ i, -HARMONY_HOOK_BOOST });
+            }
+        }
+        if (wanted_.empty() || !more) {
+            out->push_back({ YUE2_ABC_END, -HARMONY_HOOK_BOOST });
+        }
+        return !out->empty();
+    }
+
+    // The highest-scoring planner tokens, as the candidates a bias is worth computing for
+    void top_tokens(const float * logits, std::vector<int> * out) const {
+        out->clear();
+        std::vector<std::pair<float, int>> heap;
+        heap.reserve((size_t) candidates_ + 1);
+        for (int i = 0; i < YUE2_EOD; i++) {
+            float v = logits[i];
+            if ((int) heap.size() < candidates_) {
+                heap.push_back({ v, i });
+                std::push_heap(heap.begin(), heap.end(), std::greater<std::pair<float, int>>());
+            } else if (v > heap.front().first) {
+                std::pop_heap(heap.begin(), heap.end(), std::greater<std::pair<float, int>>());
+                heap.back() = { v, i };
+                std::push_heap(heap.begin(), heap.end(), std::greater<std::pair<float, int>>());
+            }
+        }
+        std::sort(heap.begin(), heap.end(), std::greater<std::pair<float, int>>());
+        for (auto & e : heap) {
+            out->push_back(e.second);
+        }
+    }
+
+    void follow_bias(const float * logits, std::map<int, float> * merged) {
+        follow_line(logits, merged);
+        // The plan may not end with sections still to write, or before the last has some chords
+        if (section_count_ < (int) wanted_.size() || section_chords_ < HARMONY_FOLLOW_LAST_CHORDS) {
+            if (merged->find(YUE2_ABC_END) == merged->end()) {
+                (*merged)[YUE2_ABC_END] = HARMONY_FOLLOW_BOOST;
+            }
+        }
+    }
+
+    void follow_line(const float * logits, std::map<int, float> * merged) {
+        const std::string & line = walk_.line;
+        if (harmony_starts_with(line, "%%")) {
+            return;
+        }
+        if (line.empty()) {
+            if (section_count_ < (int) wanted_.size()) {
+                return;
+            }
+            std::vector<int> top;
+            top_tokens(logits, &top);
+            for (int t : top) {
+                if (!vocab_[(size_t) t].empty() && vocab_[(size_t) t][0] == '%') {
+                    (*merged)[t] += HARMONY_FOLLOW_BOOST;
+                }
+            }
+            return;
+        }
+        if (line[0] != '%' || section_count_ >= (int) wanted_.size()) {
+            return;
+        }
+        std::string target  = " " + wanted_[(size_t) section_count_];
+        std::string content = line.substr(1);
+        if (!harmony_starts_with(target, content)) {
+            return;  // off the structure already
+        }
+        std::string remaining = target.substr(content.size()) + "\n";
+        auto        it        = spelling_.find(remaining);
+        if (it == spelling_.end()) {
+            std::vector<int> allowed;
+            for (int i = 0; i < (int) vocab_.size(); i++) {
+                const std::string & t = vocab_[(size_t) i];
+                if (!t.empty() && harmony_starts_with(remaining, t)) {
+                    allowed.push_back(i);
+                }
+            }
+            it = spelling_.emplace(remaining, allowed).first;
+        }
+        for (int t : it->second) {
+            (*merged)[t] += -HARMONY_FOLLOW_BOOST;
+        }
+    }
+
+    float outside_share() const {
+        if (!have_scale_ || changes_.empty()) {
+            return 0.0f;
+        }
+        int outside = 0;
+        for (const std::string & r : changes_) {
+            int pc = std::stoi(r);
+            outside += pc >= 0 && !scale_[pc];
+        }
+        return (float) outside / (float) changes_.size();
+    }
+
+    float section_penalty(int root) const {
+        if (h_.section_strength == 0.0f || previous_.empty()) {
+            return 0.0f;
+        }
+        int place = (int) opening_.size();
+        if (!opening_.empty() && root == opening_.back()) {
+            return 0.0f;  // holding the chord already chosen
+        }
+        if (place < (int) previous_.size() && place < h_.section_open && root == previous_[(size_t) place]) {
+            return h_.section_strength;
+        }
+        return 0.0f;
+    }
+
+    float hold_penalty(int root) const {
+        if (h_.hold_limit && root == last_root_ && held_ >= h_.hold_limit) {
+            return h_.chord_strength * (float) (1 + held_ - h_.hold_limit) / 4.0f;
+        }
+        return 0.0f;
+    }
+
+    float spelling_penalty(const std::vector<std::string> & completed, bool open, const std::string & partial) const {
+        const std::string &        current = changes_.back();
+        std::map<std::string, int> counts;
+        for (const std::string & c : changes_) {
+            counts[c]++;
+        }
+        float total = (float) changes_.size();
+        float score = 0.0f;
+        for (const std::string & symbol : completed) {
+            if (harmony_root(symbol) >= 0 && symbol != current) {
+                score += (float) counts[symbol] / total;
+            }
+        }
+        if (open && !partial.empty() && harmony_root(partial) >= 0 && !harmony_starts_with(current, partial)) {
+            int n = 0;
+            for (auto & kv : counts) {
+                if (harmony_starts_with(kv.first, partial) && kv.first != current) {
+                    n += kv.second;
+                }
+            }
+            score += (float) n / total;
+        }
+        return h_.chord_strength * score;
+    }
+
+    void chord_bias(const float * logits, std::map<int, float> * merged) {
+        if (changes_.empty()) {
+            return;
+        }
+        std::vector<int> top;
+        top_tokens(logits, &top);
+        if (outside_bonus_ > 0.0f && !walk_.open) {
+            bool any_quote = false;
+            for (int t : top) {
+                any_quote = any_quote || vocab_[(size_t) t].find('"') != std::string::npos;
+            }
+            if (any_quote) {
+                std::vector<bool> in(vocab_.size(), false);
+                for (int t : top) {
+                    in[(size_t) t] = true;
+                }
+                for (int t : chord_starts_) {
+                    if (!in[(size_t) t]) {
+                        top.push_back(t);
+                    }
+                }
+            }
+        }
+        std::string before = walk_.open ? walk_.partial : "";
+        bool        before_open = walk_.open;
+        std::map<std::string, int> counter;
+        for (const std::string & c : changes_) {
+            counter[c]++;
+        }
+        bool outside_allowed = outside_bonus_ > 0.0f && have_scale_ && outside_share() < h_.outside_limit;
+        float root_penalties[12];
+        for (int r = 0; r < 12; r++) {
+            const std::string & current = changes_.back();
+            std::string         ident   = std::to_string(r);
+            float               value;
+            if (ident == current) {
+                value = hold_penalty(r);
+            } else {
+                auto it = counter.find(ident);
+                int  n  = it == counter.end() ? 0 : it->second;
+                value   = h_.chord_strength * (float) n / (float) changes_.size();
+                if (outside_allowed && !scale_[r]) {
+                    value -= outside_bonus_;
+                }
+            }
+            root_penalties[r] = value;
+        }
+        for (int token : top) {
+            const std::string & text = vocab_[(size_t) token];
+            if (!before_open && text.find('"') == std::string::npos) {
+                continue;
+            }
+            HarmonyWalk w = walk_;
+            harmony_walk(text, &w);
+            std::string symbol = !w.done.empty() ? w.done[0] : (w.open ? w.partial : "");
+            int         r      = symbol.empty() ? -1 : harmony_root(symbol);
+            float       value  = 0.0f;
+            if (!root_mode_) {
+                if (w.done.empty() && !(w.open && !w.partial.empty())) {
+                    continue;
+                }
+                value = spelling_penalty(w.done, w.open, w.partial);
+                if (before.size() <= 1 && r >= 0) {
+                    value += hold_penalty(r) + section_penalty(r);
+                }
+            } else {
+                // The root is decided at its letter, and at the step after it,
+                // where an accidental or anything else settles it
+                if (symbol.empty() || r < 0 || before.size() >= 2) {
+                    continue;
+                }
+                value = root_penalties[r] + section_penalty(r);
+            }
+            if (value != 0.0f) {
+                (*merged)[token] += value;
+            }
+        }
+    }
+};
